# ============================================================
# TraceX backend configuration
# Copy this file to backend/.env and fill in real values.
# Every value has a safe local default, so the app boots with
# an EMPTY .env -- fill things in as you connect real services.
# ============================================================

# --- Core ---
APP_NAME=TraceX
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_LEVEL=INFO

# --- Relational database -------------------------------------------------
# Zero-install default (works on Windows/Linux with no extra setup):
DATABASE_URL=sqlite:///./tracex.db
# Docker Compose / production:
# DATABASE_URL=postgresql+psycopg2://tracex:tracex@localhost:5432/tracex

# --- Graph store -----------------------------------------------------------
# GRAPH_BACKEND=networkx uses an in-process graph, zero install, resets on
# restart -- good for a laptop demo. Switch to neo4j once you run docker
# compose (or your own Neo4j instance) for a persistent, queryable graph.
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password

# --- Queue / cache (optional) ----------------------------------------------
# Leave empty to run the investigation pipeline synchronously (fine for a
# single-investigator / dev setup). Set this once Redis + a Celery worker
# are running (see IMPLEMENTATION.md) to move ingestion/detection/report
# generation onto background workers, matching the "Workers" plane in the
# architecture diagram.
REDIS_URL=

# --- Blockchain data providers ---------------------------------------------
# Etherscan API v2 (unified multichain: Ethereum + Polygon use the SAME key,
# only the chain id differs -- https://docs.etherscan.io/v2-migration)
# Free tier: get a key at https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=

# Bitcoin: Blockstream's Esplora API is free and keyless.
# Self-hosted Esplora or another Bitcoin indexer also works -- just point
# BITCOIN_API_BASE_URL at it.
BITCOIN_API_BASE_URL=https://blockstream.info/api

# --- ML risk model -----------------------------------------------------------
# Path to the artifact produced by ml/src/train/train_baseline.py
# The backend degrades gracefully to the rule-based score alone if this
# file does not exist yet (i.e. before you have trained anything).
RISK_MODEL_PATH=../ml/models/wallet_risk_baseline.joblib

# --- AI Copilot (optional) --------------------------------------------------
# Leave empty to disable the copilot endpoints; every other feature works
# without it.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-4-6

# --- CORS --------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
